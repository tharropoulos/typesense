build --incompatible_strict_action_env
build --action_env=BAZEL_CXXOPTS="-std=c++17"
build --define=TYPESENSE_VERSION=\"nightly\"
build --cxxopt="-std=c++17"
build --strip=never
build --define=BRPC_WITH_GLOG=true
build --jobs=6

test --jobs=6
test --define=BRPC_WITH_GLOG=true

run --jobs=6
run --define=BRPC_WITH_GLOG=true

build --enable_platform_specific_config

build:linux --action_env=BAZEL_LINKLIBS="-l%:libstdc++.a -l%:libgcc.a"

# macOS-specific settings for Clang
build:darwin --cxxopt="-Wno-error"
build:darwin --host_cxxopt="-Wno-error"
build:darwin --conlyopt="-Wno-error"
build:darwin --host_conlyopt="-Wno-error"

# Specific flag to disable unused-but-set-variable warnings
build:darwin --cxxopt="-Wno-unused-but-set-variable"
build:darwin --host_cxxopt="-Wno-unused-but-set-variable" 

# Set action environment variables for cmake tools
build:darwin --action_env=CXXFLAGS="-Wno-error -Wno-unused-but-set-variable"
build:darwin --action_env=CFLAGS="-Wno-error"
